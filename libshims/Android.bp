cc_library_shared {
    name: "libshim_bwfocus",

    srcs: ["bwfocus_shim.c"],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    compile_multilib: "32",
    vendor: true,
}

cc_library_shared {
    name: "libcamera_metadata_helper",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "CameraMetadata.cpp",
        "CameraParameters.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libhardware",
        "libcamera_metadata",
    ],
    include_dirs: ["system/media/private/camera/include"],
}

// libandroid
cc_library_shared {
    name: "libshims_android",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "libshims_android.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "libutils",
    ],
}

cc_prebuilt_library_shared {
    name: "libbinder-v32",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["vndk/v32/arm/libbinder-v32.so"],
        },
        android_arm64: {
            srcs: ["vndk/v32/arm64/libbinder-v32.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}
